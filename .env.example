# PostgreSQL container
POSTGRES_USER=insight_admin
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=insightflow_prod

# Backend database connection
DATABASE_URL=postgresql://insight_admin:replace-with-a-strong-password@db:5432/insightflow_prod

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Use gsk-dummy-key for demo mode or provide a real key locally.
GROQ_API_KEY=gsk-dummy-key

# Async task queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Shared temporary dataset storage
UPLOAD_DIR=/data/uploads